// Type-checked JavaScript: tsc checks the JSDoc types in the builders' JavaScript templates and the Node tests, and
// emits nothing (npm run typecheck). The builders inline the templates through strip_types() in scripts/page_parts.py,
// which drops the annotations, so the generated pages do not change. scripts/templates/globals.d.ts declares the page
// globals the templates read. Left out: the viz/ and data/ ports (typed in their standalone repositories), the shared
// beamdswitch.js copies, and vendored code (scripts/vendor).
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["scripts/templates/*.js", "scripts/templates/*.d.ts", "tests/*.mjs"]
}
