// This visual's type-checked JavaScript: engine.js, handcalc.js and the tests as they are, and the built page's own
// inline scripts (the data and the UI); types/page.d.ts declares the page's globals. Left out: the inlined copies of
// engine.js, handcalc.js and beamdswitch.js (visual.json "typecheck" skips them), beamdswitch.js itself, an unchanged
// copy of yujieteo/site's templates/beamdswitch.js typed by beamdswitch.d.ts, and the vendored beamdswitch files in
// tests/fixtures/, typed by their .d.mts files.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "include": ["types/*.d.ts", "beamdswitch.d.ts", "engine.js", "handcalc.js", "tests/**/*.mjs", "tests/**/*.d.mts", ".typecheck/inline/*.js"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
