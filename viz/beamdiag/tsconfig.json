// Type-checked JavaScript: tsc checks the JSDoc types in this repository's own JavaScript and emits
// nothing; `npm ci && npm run typecheck` runs it. engine.js, handcalc.js and the tests are checked as they
// are; the built page's own inline scripts (the data and the UI) from the copies scripts/extract-
// inline.mjs writes to .typecheck/inline/, which keep index.html's line numbers. types/page.d.ts declares
// the page's globals. Left out: beamdswitch.js, an unchanged copy of yujieteo/site's
// templates/beamdswitch.js typed by beamdswitch.d.ts, and the vendored beamdswitch files in
// tests/fixtures/, typed by their .d.mts files.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["types/*.d.ts", "beamdswitch.d.ts", "engine.js", "handcalc.js", "scripts/*.mjs", "tests/**/*.mjs", "tests/**/*.d.mts", ".typecheck/inline/*.js"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
