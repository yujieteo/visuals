  },
  "max_factors": 12,
  "rules": {
    "precedence": "× and ÷ before +; each + starts a new term (a sum of multiplicative terms)",
    "range": "Exact for zero-or-positive values: lowest result takes × factors at low and ÷ factors at high; highest result the opposite. Blank low or high means the same as best.",
    "sensitivity": "For each factor, the others held at best: score = |ln(result at high / result at low)|; output ratio ≥ 2 large, ≥ 1.25 medium, > 1.02 small. A factor that can take the result to zero ranks first.",
    "formatting": "About two significant figures; one when high / low ≥ 10. Below 0.001 or from 10^15, scientific notation.",
    "units": "Exact unit strings of the form word or word/word cancel within a term; a mixed-unit warning only when every factor has a recognised unit and the + terms clearly differ."
  },
  "notes": {
    "range": "This range comes from the low and high values you entered. It is not a measured confidence interval.",
    "caveat": "The answer is only as good as these assumptions. The range shows how your chosen low and high values propagate through the calculation.",
