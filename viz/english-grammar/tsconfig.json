// This visual's type-checked JavaScript: the page sources in src/ (the builder strips their JSDoc before
// inlining them, so the page does not change), report.js, the page's other inline scripts that
// scripts/typecheck.mjs copies to .typecheck/inline/ (visual.json "typecheck" skips the copies of src/,
// report.js and the shared deck templates) and the tests, with the shared page globals. The vendored
// beamdswitch parser in tests/fixtures/beamdswitch/ stays unedited; its .d.mts types it. Compiler options
// come from the repository's tsconfig.base.json; scripts/typecheck.mjs runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "include": ["src/*.js", "report.js", ".typecheck/inline/*.js", "src/*.d.ts", "tests/*.mjs", "tests/*.d.ts", "tests/fixtures/beamdswitch/*.d.mts", "../../scripts/types/*.d.ts"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
