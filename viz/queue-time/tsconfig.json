// This visual's type-checked JavaScript: the tests and the page's own inline scripts, as global scripts, as the browser
// runs them (moduleDetection legacy). types/ declares what the left-out copies provide. Left out: the inlined
// beamdswitch block (visual.json "typecheck" skips it), beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies
// of yujieteo/site's template and beamdswitch's parser; deck.d.mts types the parser.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
