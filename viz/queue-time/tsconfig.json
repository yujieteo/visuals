// Type-checked JavaScript: tsc checks the JSDoc types in this repository's own JavaScript and emits nothing.
// `npm run typecheck` first runs scripts/extract-inline.mjs, which copies the page's own inline scripts out of
// index.html into .typecheck/inline/ as global scripts, as the browser runs them. types/ declares what the
// left-out copies provide. Left out: beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of
// yujieteo/site's template and beamdswitch's parser (and so the inline beamdswitch copy too); deck.d.mts types
// the parser.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["scripts/*.mjs", "tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
