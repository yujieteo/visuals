      "hypotheses": [],
      "lead": "ker α → ker β → ker γ —δ→ coker α → coker β → coker γ, exact at every term; each junction has its own chase.",
      "tex": [
        "\\ker\\alpha \\to \\ker\\beta \\to \\ker\\gamma \\xrightarrow{\\delta} \\operatorname{coker}\\alpha \\to \\operatorname{coker}\\beta \\to \\operatorname{coker}\\gamma"
      ]
    }
  ],
  "exactness": {
    "exact/ker-beta": {
      "claim": "im(ker α → ker β) = ker(ker β → ker γ)",
      "easy": "p'(i'(a')) = 0, so the composite is zero.",
      "steps": [
        {
          "id": "exact/ker-beta/start",
          "title": "Start in ker β",
          "move": "given",
          "uses": [
            "kb-start"
          ],
          "hypotheses": [],
          "lead": "Let b′ ∈ ker β whose image in C′ vanishes: β(b′) = 0 and p′(b′) = 0.",
          "tex": [
            "\\beta(b') = 0, \\quad p'(b') = 0"
          ]
        },
        {
          "id": "exact/ker-beta/lift",
          "title": "Exactness of the upper row",
          "move": "exact",
          "uses": [
            "kb-lift"
          ],
          "hypotheses": [
            "exact-at-B-prime"
          ],
          "lead": "p′(b′) = 0, so by exactness of the upper row b′ = i′(a′) for some a′ ∈ A′.",
          "tex": [
            "b' \\in \\ker p' = \\operatorname{im} i'",
            "b' = i'(a')"
          ]
        },
        {
          "id": "exact/ker-beta/commute",
          "title": "Push a′ down",
          "move": "commute",
          "uses": [
            "kb-commute"
          ],
          "hypotheses": [
            "left-square-commutes"
          ],
          "lead": "The left square commutes: i(α(a′)) = β(i′(a′)) = β(b′) = 0.",
          "tex": [
            "i(\\alpha(a')) = \\beta(i'(a')) = \\beta(b') = 0"
          ]
        },
        {
          "id": "exact/ker-beta/inject",
          "title": "Cancel i",
          "move": "kernel",
          "uses": [
            "kb-inject",
            "kb-done"
          ],
          "hypotheses": [
            "i-injective"
          ],
          "lead": "i is injective, so α(a′) = 0: a′ ∈ ker α and i′(a′) = b′. So b′ comes from ker α.",
          "tex": [
            "\\alpha(a') = 0",
            "a' \\in \\ker\\alpha, \\quad i'(a') = b'"
          ]
        }
      ]
    },
    "exact/ker-gamma": {
      "claim": "im(ker β → ker γ) = ker δ",
      "easy": "For b′ ∈ ker β, use b′ itself as the lift of p′(b′): β(b′) = 0 = i(0), so δ(p′(b′)) = [0].",
      "steps": [
        {
          "id": "exact/ker-gamma/start",
          "title": "Start with δ(c′) = 0",
          "move": "given",
          "uses": [
            "kg-start"
          ],
          "hypotheses": [],
          "lead": "Take c′ ∈ ker γ with δ(c′) = 0. Construct δ(c′) = [a] with a lift b′ and i(a) = β(b′).",
          "tex": [
            "\\delta(c') = [a] = 0"
          ]
