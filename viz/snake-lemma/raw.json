    "exact/coker-beta": {
      "claim": "im(coker α → coker β) = ker(coker β → coker γ)",
      "easy": "p(i(a)) = 0, so the composite is zero.",
      "steps": [
        {
          "id": "exact/coker-beta/start",
          "title": "[b] dies in coker γ",
          "move": "given",
          "uses": [
            "cb-start"
