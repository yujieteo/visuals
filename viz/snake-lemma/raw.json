      ],
      "hypotheses": [
        "exact-at-B-prime"
      ],
      "lead": "Try another lift: p′(b′₁) = p′(b′₂) = c′, so p′(b′₁ − b′₂) = 0 and b′₁ − b′₂ ∈ ker p′ = im i′.",
      "tex": [
        "p'(b'_1 - b'_2) = 0",
        "b'_1 - b'_2 \\in \\ker p' = \\operatorname{im} i'",
        "b'_1 - b'_2 = i'(a')"
      ]
    },
    {
      "id": "proof/well-defined",
      "title": "Why the answer is well-defined",
      "move": "quotient",
      "uses": [
