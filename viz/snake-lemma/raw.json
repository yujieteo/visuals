  "proof": [
    {
      "id": "proof/diagram",
      "title": "The commutative diagram",
      "move": "setting",
      "uses": [],
      "hypotheses": [],
      "lead": "Two short exact rows joined by three vertical maps α, β, γ; both squares commute.",
      "tex": [
        "0 \\to A' \\xrightarrow{i'} B' \\xrightarrow{p'} C' \\to 0",
        "0 \\to A \\xrightarrow{i} B \\xrightarrow{p} C \\to 0",
        "p\\,\\beta = \\gamma\\, p', \\qquad \\beta\\, i' = i\\,\\alpha"
      ]
    },
    {
      "id": "proof/goal",
      "title": "What must be constructed?",
      "move": "question",
      "uses": [],
      "hypotheses": [],
      "lead": "Goal: a map from ker γ (top right) to coker α (bottom left), the two corners nothing connects yet.",
      "tex": [
        "\\delta : \\ker\\gamma \\longrightarrow \\operatorname{coker}\\alpha \\;?"
      ]
    },
    {
      "id": "proof/start",
      "title": "Start with c′ ∈ ker γ",
      "move": "given",
      "uses": [
        "gamma-c-prime-zero"
      ],
      "hypotheses": [],
      "lead": "Take c′ ∈ C′ with γ(c′) = 0: it lives in C′, and what we know about it is that γ kills it.",
      "tex": [
        "c' \\in \\ker\\gamma",
        "\\gamma(c') = 0"
      ]
    },
    {
      "id": "proof/lift",
      "title": "Lift c′ to B′",
      "move": "lift",
      "uses": [
        "lift-c-prime"
      ],
      "hypotheses": [
        "p-prime-surjective"
      ],
      "lead": "Because p′ is surjective, choose b′ ∈ B′ with p′(b′) = c′. This is a CHOICE.",
      "tex": [
        "p'(b') = c'"
      ]
    },
    {
      "id": "proof/down",
      "title": "Move down by β",
      "move": "apply",
      "uses": [
        "compute-beta"
      ],
      "hypotheses": [],
      "lead": "Apply β: b′ ↦ β(b′) ∈ B. Applying a map needs no hypothesis.",
      "tex": [
        "b' \\mapsto \\beta(b')"
      ]
    },
    {
      "id": "proof/ask",
      "title": "Where does β(b′) go under p?",
      "move": "question",
      "uses": [
        "compute-beta"
      ],
      "hypotheses": [],
      "lead": "Where does β(b′) go under p? Computing p(β(b′)) directly tells us nothing yet.",
      "tex": [
        "p(\\beta(b')) = \\;?"
      ]
    },
    {
      "id": "proof/commutativity",
      "title": "Use commutativity",
      "move": "commute",
      "uses": [
        "beta-in-kernel-p"
      ],
      "hypotheses": [
        "right-square-commutes"
      ],
      "lead": "The right square commutes, so p(β(b′)) = γ(p′(b′)) = γ(c′) = 0. Hence β(b′) ∈ ker p.",
      "tex": [
        "p(\\beta(b')) = \\gamma(p'(b'))",
        "= \\gamma(c')",
        "= 0"
      ]
    },
    {
      "id": "proof/exactness",
      "title": "Use exactness",
      "move": "exact",
      "uses": [
        "solve-for-a",
        "a-unique"
      ],
      "hypotheses": [
        "exact-at-B",
        "i-injective"
      ],
      "lead": "β(b′) ∈ ker p = im i, so there is a ∈ A with i(a) = β(b′): a preimage forced to exist by exactness. As i is injective, a is unique once b′ is fixed.",
      "tex": [
        "\\beta(b') \\in \\ker p = \\operatorname{im} i",
        "i(a) = \\beta(b')"
      ]
    },
    {
      "id": "proof/quotient",
      "title": "Pass to coker α",
      "move": "quotient",
      "uses": [
        "quotient-a"
      ],
      "hypotheses": [],
      "lead": "a still depends on the chosen lift. Send a ↦ [a] ∈ A / im α = coker α: information is deliberately being forgotten here.",
      "tex": [
        "a \\mapsto [a] \\in A/\\operatorname{im}\\alpha = \\operatorname{coker}\\alpha"
      ]
    },
    {
      "id": "proof/delta",
      "title": "The connecting morphism δ",
      "move": "define",
      "uses": [
        "define-delta"
      ],
      "hypotheses": [],
      "lead": "Define δ(c′) = [a]. The snake path C′ ← B′ ↓ B ← A is the compressed record of the whole chase.",
      "tex": [
        "\\delta(c') = [a]",
        "\\delta : \\ker\\gamma \\longrightarrow \\operatorname{coker}\\alpha"
      ]
    },
    {
      "id": "proof/another-lift",
      "title": "Why the lift is not unique",
      "move": "lift",
      "uses": [
