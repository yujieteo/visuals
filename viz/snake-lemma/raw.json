      "hypotheses": [],
      "lead": "β(b′₁) − β(b′₂) = β(i′(a′)) = i(α(a′)); as i is injective, a₁ − a₂ = α(a′), so [a₁] = [a₂] ∈ A / im α.",
      "tex": [
        "\\beta(b'_1) - \\beta(b'_2) = \\beta(i'(a')) = i(\\alpha(a'))",
        "a_1 - a_2 = \\alpha(a')",
        "[a_1] = [a_2] \\in A/\\operatorname{im}\\alpha"
