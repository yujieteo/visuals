          ],
          "lead": "γ(p′(b′)) = p(β(b′)) = p(i(a)) = 0, so p′(b′) ∈ ker γ.",
          "tex": [
            "\\gamma(p'(b')) = p(\\beta(b')) = p(i(a)) = 0"
          ]
        },
        {
          "id": "exact/coker-alpha/chase",
          "title": "Chase it back through δ",
          "move": "define",
          "uses": [
            "ca-chase"
          ],
          "hypotheses": [
            "i-injective"
          ],
          "lead": "Chasing p′(b′) through δ with lift b′ gives i(a) = β(b′), hence δ(p′(b′)) = [a]. So [a] ∈ im δ.",
          "tex": [
            "\\delta(p'(b')) = [a]"
          ]
        }
      ]
