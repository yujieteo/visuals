          ],
          "lead": "p(b − β(b′)) = γ(c′) − γ(p′(b′)) = 0, by the right square.",
          "tex": [
            "p(b - \\beta(b')) = \\gamma(c') - \\gamma(p'(b')) = 0"
          ]
        },
        {
          "id": "exact/coker-beta/exact",
