        {
          "id": "exact/ker-gamma/correct",
          "title": "Correct the lift",
          "move": "correct",
          "uses": [
            "kg-correct"
          ],
          "hypotheses": [
            "left-square-commutes"
          ],
          "lead": "Use a′ to modify the chosen lift: b′ ↦ b′ − i′(a′). Then β(b′ − i′(a′)) = β(b′) − i(α(a′)) = i(a) − i(a) = 0.",
          "tex": [
            "b' \\mapsto b' - i'(a')",
            "\\beta(b' - i'(a')) = \\beta(b') - i(\\alpha(a')) = i(a) - i(a) = 0"
          ]
        },
        {
          "id": "exact/ker-gamma/still",
          "title": "Still a lift of c′",
          "move": "kernel",
          "uses": [
