          "hypotheses": [],
          "lead": "Start with [b] ∈ coker β whose image in coker γ is zero: p(b) = γ(c′) for some c′ ∈ C′.",
          "tex": [
            "[p(b)] = 0 \\iff p(b) = \\gamma(c')"
