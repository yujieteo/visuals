    {
      "id": "Bi",
      "tex": "Bi",
      "label": "Bi",
      "name": "Biot number",
      "def": "Bi=\\frac{hL_c}{k_s}",
      "plain": "Bi = hL_c/k_s",
      "forms": [
        [
          {
            "q": "heat-transfer-coefficient",
            "e": 1
          },
