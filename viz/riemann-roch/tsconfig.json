// This visual's type-checked JavaScript: the engine and the page code at their sources in src/, build.mjs, the tests and
// the other inline scripts of src/template.html (visual.json "typecheck" names it), as global scripts (moduleDetection
// legacy). types/ declares the globals the page's scripts share and what the left-out copies provide. Left out:
// beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and beamdswitch's parser
// (deck.d.mts types the parser), and the built index.html, whose scripts are the sources.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["src/*.js", "build.mjs", "tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
