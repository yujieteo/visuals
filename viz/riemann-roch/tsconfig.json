// Type-checked JavaScript: tsc checks the JSDoc types in this repository's own JavaScript and emits nothing.
// `npm run typecheck` first runs scripts/extract-inline.mjs, which copies src/template.html's own inline
// scripts into .typecheck/inline/. The engine and the page code are checked at their sources in src/.
// types/ declares the globals the page's scripts share and what the left-out copies provide. Left out:
// beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and
// beamdswitch's parser (deck.d.mts types the parser), and the built index.html, whose scripts are the sources.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/*.js", "build.mjs", "scripts/*.mjs", "tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
