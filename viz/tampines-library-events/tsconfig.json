// This visual's type-checked JavaScript: the tests and the page's own inline scripts (the model and the UI), as
// global scripts, as the browser runs them (moduleDetection legacy). types/ declares the model's global and WebMCP.
// The events-data block is JSON and is left out by the extractor. Compiler options come from the repository's
// tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for this visual after npm ci at the root,
// copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
