  cal-20261002-s4-005,s1,skills/verify-post-deploy.md (Stage B),"https://github.com/yujieteo/site/blob/ff0c675b6072cf10768644132fb6936fd8cf1f1d/skills/verify-post-deploy.md",null,"2026-10-02T07:28:00Z"
