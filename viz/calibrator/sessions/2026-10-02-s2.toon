  cal-20261002-s2-003,s2,"Calibrator history, data/calibrator/raw.toon at f650447","https://github.com/yujieteo/site/blob/f650447a16c69c909dd232dec1e7f8606696dce3/data/calibrator/raw.toon","2026-10-02T04:49:24Z","2026-10-02T04:56:00Z"
  cal-20261002-s2-022,s1,FPL API bootstrap-static,"https://fantasy.premierleague.com/api/bootstrap-static/",null,"2026-10-02T04:56:00Z"
