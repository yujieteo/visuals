{
  "title": "Calibrator",
  "description": "Metadata for the Calibrator TOON schemas: the probability session (calibrator-session) and the life interview batch (optchat-interview, under interview), with the fields of each table they import and export, and the allowed values. Documented in README.md.",
  "format": "calibrator-session",
  "version": 1,
  "import_fields": {
    "session": [
      "session_id",
      "generated_at",
      "generator",
      "inputs"
    ],
    "questions": [
      "question_id",
      "session_id",
      "proposition",
      "context",
      "high_action",
      "low_action",
      "origin",
      "info_gain",
      "action_impact",
      "novelty",
      "adversariality",
      "relevance",
      "explore_exploit",
      "resolution_rule",
      "resolution_horizon",
      "resolution_status",
      "outcome",
      "resolution_evidence",
      "generated_at"
    ],
    "sources": [
      "question_id",
      "source_id",
      "title",
      "url",
      "published_at",
      "retrieved_at"
    ],
    "claims": [
      "question_id",
      "source_id",
      "claim"
    ]
  },
  "export_fields": {
    "session": [
      "session_id",
      "generated_at",
      "generator",
      "inputs",
      "question_count",
      "imported_at",
      "exported_at",
      "answered",
      "skipped",
      "unseen"
    ],
    "responses": [
      "question_id",
      "state",
      "first_probability",
      "final_probability",
      "revision_count",
      "time_to_first_answer_ms",
      "time_to_final_answer_ms",
      "first_shown_at",
      "first_answered_at",
      "final_answered_at"
    ],
    "revisions": [
      "question_id",
      "revision",
      "probability",
      "at",
      "ms_since_first_shown"
    ]
  },
  "origins": [
    "news",
    "notes",
    "project",
    "calibration",
    "synthesis"
  ],
  "scores": [
    "info_gain",
    "action_impact",
    "novelty",
    "adversariality",
    "relevance"
  ],
  "score_range": [
    0,
    100
  ],
  "probability_range": [
    0,
    100
  ],
  "states": [
    "answered",
    "skipped",
    "unseen"
  ],
  "storage_keys": [
    "calibrator:session",
    "calibrator:previous"
  ],
  "interview": {
    "format": "optchat-interview",
    "version": 1,
    "import_fields": {
      "batch": [
        "batch_id",
        "generated_at",
        "generator",
        "inputs"
      ],
      "questions": [
        "question_id",
        "batch_id",
        "prompt",
        "context",
        "topic",
        "period",
        "gap",
        "generated_at"
      ],
      "evidence": [
        "question_id",
        "ref",
        "reason"
      ]
    },
    "export_fields": {
      "batch": [
        "batch_id",
        "generated_at",
        "generator",
        "inputs",
        "question_count",
        "imported_at",
        "exported_at",
        "answered",
        "dont_remember",
        "skipped",
        "unseen"
      ],
      "responses": [
        "question_id",
        "state",
        "revision_count",
        "first_shown_at",
        "first_submitted_at",
        "final_submitted_at"
      ],
      "answers": [
        "question_id",
        "revision",
        "kind",
        "text",
        "confidence",
        "event_date",
        "submitted_at"
      ]
    },
    "states": [
      "answered",
      "dont_remember",
      "skipped",
      "unseen"
    ],
    "answer_kinds": [
      "answer",
      "dont_remember"
    ],
    "confidence_range": [
      0,
      100
    ],
    "storage_keys": [
      "calibrator:interview",
      "calibrator:interview-previous",
      "calibrator:mode"
    ]
  }
}
