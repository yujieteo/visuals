// This visual's type-checked JavaScript: the page sources in src/ (the builder strips their JSDoc before
// inlining them, so the page does not change), the page's other inline scripts that scripts/typecheck.mjs
// copies to .typecheck/inline/ (visual.json "typecheck" skips the copies of src/ and the shared deck
// templates), with the shared page globals; the imported tests are not typed yet. Compiler options
// come from the repository's tsconfig.base.json; scripts/typecheck.mjs runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "include": ["src/*.js", ".typecheck/inline/*.js", "src/*.d.ts", "../../scripts/types/*.d.ts"]
}
