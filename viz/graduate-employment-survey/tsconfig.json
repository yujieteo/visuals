// Type-checked JavaScript: tsc checks the JSDoc types in report.js and the Node tests, and emits nothing.
// index.html is generated by the yujieteo/visuals builder, which owns its main script's types; the page
// inlines report.js and beamdswitch.js verbatim. beamdswitch.js (the site's shared template) and the
// vendored deck parser stay unedited, typed by tests/beamdswitch-template.d.ts and their .d.mts files.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["report.js", "tests/**/*.mjs", "tests/**/*.d.ts", "tests/**/*.d.mts"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
