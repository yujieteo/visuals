// This visual's type-checked JavaScript: the lab's scripts (engine.js, lessons.js, ui.js), raw.mjs, the Node tests and
// the page's own inline scripts. Left out: the blocks build.py inlines from the checked files and beamdswitch.js (the
// site's shared template, copied verbatim), which visual.json "typecheck" skips, and beamdswitch's vendored parsers in
// tests/fixtures/, typed by their .d.mts files. raw.mjs imports JSON, hence resolveJsonModule.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "resolveJsonModule": true },
  "include": ["engine.js", "lessons.js", "ui.js", "raw.mjs", "tests/**/*.mjs", "tests/**/*.d.ts", "tests/**/*.d.mts", ".typecheck/inline/*.js"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
