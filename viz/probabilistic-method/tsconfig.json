// This visual's type-checked JavaScript: the engine (src/engine/) and the page code (src/ui/) at their sources, build.mjs,
// the tests and the other inline scripts of template.html (visual.json "typecheck" names it). build.mjs wraps each
// source in its own function scope, but the checker sees every fragment as one global script (moduleDetection
// legacy), so the page reaches the engine only through PM. types/ declares what the left-out copies provide. Left out:
// beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and beamdswitch's parser
// (deck.d.mts types the parser), and the built index.html, whose scripts are the sources above.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["src/**/*.js", "build.mjs", "tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
