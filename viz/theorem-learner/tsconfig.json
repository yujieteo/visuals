// Theorem Learner: proofs from concepts to results's type-checked JavaScript: src/, report.js and the tests, with the kit's types and the page globals.
// The page inlines each of those files unchanged (visual.json "typecheck" skips the copies) and the vendored
// MathJax block is never checked (data-vendor). Generated by scripts/new_visual.py; --update rewrites this file.
{
  "extends": "../../tsconfig.base.json",
  "include": ["src/*.js", "report.js", "tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js", "../../scripts/types/*.d.ts"]
}
