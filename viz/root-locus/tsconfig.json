// This visual's type-checked JavaScript: the tests and the page's own inline scripts, as global scripts, as the browser
// runs them (moduleDetection legacy); the page's main script, which has no id, becomes script-3.js. types/ declares
// what the left-out copies provide. Left out: the inlined copy of beamdswitch.js (visual.json "typecheck" skips it),
// beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and beamdswitch's parser;
// deck.d.mts and plot.d.mts type the parsers.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["tests/*.mjs", "tests/*.cjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
