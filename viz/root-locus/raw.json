 "verification": [
  {
   "case": "L = K/(s(s+1)(s+2))",
   "expected": "critical K = 6 at w = sqrt(2) = 1.4142 rad/s; breakaway at s = -0.4226 (K = 0.3849); asymptote centroid -1, angles 60, 180, 300 degrees"
  },
  {
   "case": "L = K(s+3)/(s(s+1))",
   "expected": "breakaway at s = -3 + sqrt(6) = -0.5505 (K = 0.1010); break-in at s = -3 - sqrt(6) = -5.4495 (K = 9.899)"
  },
  {
   "case": "G = 1/(s+1), z-mode, ZOH, T = 1",
   "expected": "G(z) = 0.63212/(z - 0.36788); unit-circle crossing at z = -1 with K = 2.1640"
  },
  {
   "case": "G = (s+1)/(s(s+2))",
   "expected": "no real breakaway point; locus segments on (-1, 0) and (-inf, -2)"
  },
  {
   "case": "improper input s**2/(s+1)",
   "expected": "rejected with an explanation"
  },
  {
   "case": "cancellation (s+1)/((s+1)(s+2))",
   "expected": "flagged"
  }
 ]
