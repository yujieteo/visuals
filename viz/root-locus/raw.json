{
 "title": "Root locus design check",
 "slug": "root-locus",
 "version": "1.0.0",
 "schema_version": 1,
 "summary": "Type C, G and H in a Python-like syntax, see the s-plane or z-plane root locus for K >= 0, pick K, and check the closed-loop poles against damping, natural-frequency and settling-time requirements. Exports and re-imports a Markdown record.",
 "loop": {
  "open_loop": "L = K*C*G*H",
  "closed_loop": "T = K*C*G / (1 + K*C*G*H)",
  "feedback": "negative; H = 1 by default",
  "gain": "K >= 0"
 },
 "method": {
  "roots": "eigenvalues of the balanced companion matrix of D + K*N (Francis QR), Durand-Kerner fallback",
  "tracking": "adaptive K grid (log and linear mix); nearest-neighbour optimal matching; the K step halves when a match is ambiguous or a root moves too far",
  "breakaway": "real roots of N*D' - N'*D on the locus, with K = -D/N",
  "crossings": "s-plane: real roots of Im(D(jw) conj N(jw)); z-plane: unit circle via Chebyshev polynomials plus z = +1 and z = -1",
  "requirements": "K intervals by bisection between sweep samples where every closed-loop pole enters or leaves the allowed region",
  "max_order": 12
 },
 "discretisation": {
  "zoh": "state-space realisation, matrix exponential by scaling and squaring (Pade 6), G(z) = (1 - z^-1) Z{G(s)/s}",
  "tustin": "s = (2/T)(z - 1)/(z + 1)",
  "matched": "z = exp(sT) for poles and zeros, zeros at z = -1 for the pole excess, DC gain matched (or at a low frequency with an integrator)"
 },
 "delay": {
  "s": "Pade approximation of order 1 to 4 (adds right-half-plane zeros)",
  "z": "whole samples, factor z**-n (exact)"
 },
 "requirements": {
  "zetaMin": "minimum damping ratio",
  "wnMin": "minimum natural frequency (rad/s)",
  "wnMax": "maximum natural frequency (rad/s)",
  "settlingTime": "settling time Ts (s), Re(s) <= -4/Ts (2 percent)",
  "stability": "strict stability, always on"
 },
