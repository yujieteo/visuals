// This visual's type-checked JavaScript: the tests and the page's own inline scripts, whose shared globals
// types/page.d.ts declares. Left out: the inlined beamdswitch block (visual.json "typecheck" skips it), an unchanged
// copy of yujieteo/site's templates/beamdswitch.js, and beamdswitch's vendored parser in tests/fixtures/, typed by
// its .d.mts file.
// Compiler options come from the repository's tsconfig.base.json; scripts/typecheck.mjs, which scripts/check.py runs for
// this visual after npm ci at the root, copies the page's inline scripts to .typecheck/inline/ and runs tsc on this file.
{
  "extends": "../../tsconfig.base.json",
  "include": ["types/*.d.ts", "tests/**/*.mjs", "tests/**/*.d.mts", ".typecheck/inline/*.js"],
  "exclude": ["tests/fixtures/beamdswitch/*.mjs"]
}
