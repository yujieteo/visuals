// This visual's type-checked JavaScript: the tests and the page's inline scripts, as global scripts
// (moduleDetection legacy). scripts/typecheck.mjs copies the inline scripts to .typecheck/inline/.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "module": "nodenext", "moduleResolution": "nodenext", "moduleDetection": "legacy" },
  "include": ["tests/*.mjs", "types/*.d.ts", ".typecheck/inline/*.js"]
}
