 {"id":"coalesce","operation":"Null handling: coalesce fills a missing value","pipeline":{"source":"orders","steps":[{"op":"compute","name":"city","kind":"fill","column":"city","value":"(none)"},{"op":"columns","keep":["order_id","city"]}]},"sql":"SELECT __row, order_id, coalesce(city, '(none)') AS city FROM orders ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","city"],"rows":[["1","1","Oslo"],["2","2","Lima"],["3","3","Lima"],["4","4","Pune"],["5","5","Oslo"],["6","6","(none)"]]},"sql":{"columns":["__row","order_id","city"],"rows":[["1","1","Oslo"],["2","2","Lima"],["3","3","Lima"],["4","4","Pune"],["5","5","Oslo"],["6","6","(none)"]]}}},
 {"id":"readings","operation":"Readings: the workbench's reading of thousands separators","pipeline":{"source":"orders","steps":[{"op":"readings","columns":["amount"]},{"op":"columns","keep":["order_id","amount"]}]},"expect":{"controls":{"columns":["__row","order_id","amount"],"rows":[["1","1","1200.0"],["2","2","40.0"],["3","3",null],["4","4","75.0"],["5","5",null],["6","6","10.0"]]}}},
 {"id":"group","operation":"Grouping and aggregates: the missing key is a group; COUNT(*) beside COUNT(column)","pipeline":{"source":"orders","steps":[{"op":"aggregate","by":["city"],"measures":[{"fn":"count"},{"fn":"count_values","column":"amount"},{"fn":"sum","column":"amount"}]}]},"sql":"SELECT city, count(*) AS rows, count(amount) AS n_amount, sum(TRY_CAST(amount AS DOUBLE)) AS sum_amount FROM orders GROUP BY city ORDER BY city NULLS LAST","expect":{"controls":{"columns":["city","rows","n_amount","sum_amount"],"rows":[["Lima","2","1","40.0"],["Oslo","2","2",null],["Pune","1","1","75.0"],[null,"1","1","10.0"]]},"sql":{"columns":["city","rows","n_amount","sum_amount"],"rows":[["Lima","2","1","40.0"],["Oslo","2","2",null],["Pune","1","1","75.0"],[null,"1","1","10.0"]]}}},
 {"id":"having","operation":"HAVING keeps groups by an aggregate","pipeline":{"source":"orders","steps":[{"op":"aggregate","by":["customer"],"measures":[{"fn":"count"}],"having":{"measure":"rows","op":">","value":"1"}}]},"sql":"SELECT customer, count(*) AS rows FROM orders GROUP BY customer HAVING count(*) > 1 ORDER BY customer NULLS LAST","expect":{"controls":{"columns":["customer","rows"],"rows":[["c1","2"],["c2","2"]]},"sql":{"columns":["customer","rows"],"rows":[["c1","2"],["c2","2"]]}}},
 {"id":"join-inner","operation":"Inner join: missing keys never match; a duplicate key repeats rows","pipeline":{"source":"orders","steps":[{"op":"join","table":"customers","kind":"inner","keys":[{"left":"customer","right":"customer"}]},{"op":"columns","keep":["order_id","name"]}]},"sql":"SELECT o.__row, o.order_id, c.name FROM orders o JOIN customers c ON o.customer = c.customer ORDER BY o.__row, c.__row","expect":{"controls":{"columns":["__row","__row_customers","order_id","name"],"rows":[["1","1","1","Ann"],["2","2","2","Bo"],["2","3","2","Bo B"],["3","2","3","Bo"],["3","3","3","Bo B"],["6","1","6","Ann"]]},"sql":{"columns":["__row","order_id","name"],"rows":[["1","1","Ann"],["2","2","Bo"],["2","2","Bo B"],["3","3","Bo"],["3","3","Bo B"],["6","6","Ann"]]}}},
 {"id":"join-left","operation":"Left join: every left row, unmatched ones with missing values","pipeline":{"source":"orders","steps":[{"op":"join","table":"customers","kind":"left","keys":[{"left":"customer","right":"customer"}]},{"op":"columns","keep":["order_id","name"]}]},"sql":"SELECT o.__row, o.order_id, c.name FROM orders o LEFT JOIN customers c ON o.customer = c.customer ORDER BY o.__row, c.__row","expect":{"controls":{"columns":["__row","__row_customers","order_id","name"],"rows":[["1","1","1","Ann"],["2","2","2","Bo"],["2","3","2","Bo B"],["3","2","3","Bo"],["3","3","3","Bo B"],["4",null,"4",null],["5",null,"5",null],["6","1","6","Ann"]]},"sql":{"columns":["__row","order_id","name"],"rows":[["1","1","Ann"],["2","2","Bo"],["2","2","Bo B"],["3","3","Bo"],["3","3","Bo B"],["4","4",null],["5","5",null],["6","6","Ann"]]}}},
 {"id":"join-right","operation":"Right join: every right row","pipeline":{"source":"orders","steps":[{"op":"join","table":"customers","kind":"right","keys":[{"left":"customer","right":"customer"}]},{"op":"columns","keep":["order_id","name"]}]},"sql":"SELECT o.order_id, c.name FROM orders o RIGHT JOIN customers c ON o.customer = c.customer ORDER BY ALL","expect":{"controls":{"columns":["__row","__row_customers","order_id","name"],"rows":[["1","1","1","Ann"],["2","2","2","Bo"],["2","3","2","Bo B"],["3","2","3","Bo"],["3","3","3","Bo B"],["6","1","6","Ann"],[null,"4",null,"Cy"],[null,"5",null,"Nobody"]]},"sql":{"columns":["order_id","name"],"rows":[["1","Ann"],["2","Bo"],["2","Bo B"],["3","Bo"],["3","Bo B"],["6","Ann"],[null,"Cy"],[null,"Nobody"]]}}},
