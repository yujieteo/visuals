 {"id":"join-cross","operation":"Cross join: every pair","pipeline":{"source":"customers","steps":[{"op":"filter","conditions":[{"column":"tier","op":"=","value":"gold"}]},{"op":"join","table":"customers","kind":"cross"},{"op":"columns","keep":["name","name_customers"]}]},"sql":"SELECT a.__row, b.__row, a.name, b.name AS name_customers FROM customers a CROSS JOIN customers b WHERE a.tier = 'gold' ORDER BY a.__row, b.__row","expect":{"controls":{"columns":["__row","__row_customers","name","name_customers"],"rows":[["1","1","Ann","Ann"],["1","2","Ann","Bo"],["1","3","Ann","Bo B"],["1","4","Ann","Cy"],["1","5","Ann","Nobody"]]},"sql":{"columns":["__row","__row_1","name","name_customers"],"rows":[["1","1","Ann","Ann"],["1","2","Ann","Bo"],["1","3","Ann","Bo B"],["1","4","Ann","Cy"],["1","5","Ann","Nobody"]]}}},
 {"id":"join-semi","operation":"Semi join: left rows with a match, never repeated","pipeline":{"source":"orders","steps":[{"op":"join","table":"customers","kind":"semi","keys":[{"left":"customer","right":"customer"}]},{"op":"columns","keep":["order_id"]}]},"sql":"SELECT __row, order_id FROM orders o SEMI JOIN customers c ON o.customer = c.customer ORDER BY __row","expect":{"controls":{"columns":["__row","order_id"],"rows":[["1","1"],["2","2"],["3","3"],["6","6"]]},"sql":{"columns":["__row","order_id"],"rows":[["1","1"],["2","2"],["3","3"],["6","6"]]}}},
