 {"id":"select","operation":"Selection: choose and rename columns","pipeline":{"source":"orders","steps":[{"op":"columns","keep":["city","customer"],"rename":{"customer":"who"}}]},"sql":"SELECT __row, city, customer AS who FROM orders ORDER BY __row","expect":{"controls":{"columns":["__row","city","who"],"rows":[["1","Oslo","c1"],["2","Lima","c2"],["3","Lima","c2"],["4","Pune",null],["5","Oslo","c9"],["6",null,"c1"]]},"sql":{"columns":["__row","city","who"],"rows":[["1","Oslo","c1"],["2","Lima","c2"],["3","Lima","c2"],["4","Pune",null],["5","Oslo","c9"],["6",null,"c1"]]}}},
 {"id":"filter","operation":"Filtering: a comparison drops missing values","pipeline":{"source":"orders","steps":[{"op":"filter","match":"all","conditions":[{"column":"city","op":"=","value":"Oslo"}]}]},"sql":"SELECT * FROM orders WHERE city = 'Oslo' ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","customer","city","amount","placed","parent"],"rows":[["1","1","c1","Oslo","1,200","2026-01-03",null],["5","5","c9","Oslo","abc","2026-03-01","4"]]},"sql":{"columns":["__row","order_id","customer","city","amount","placed","parent"],"rows":[["1","1","c1","Oslo","1,200","2026-01-03",null],["5","5","c9","Oslo","abc","2026-03-01","4"]]}}},
 {"id":"filter-missing","operation":"Null handling: IS NULL keeps the missing values","pipeline":{"source":"orders","steps":[{"op":"filter","match":"any","conditions":[{"column":"customer","op":"missing"},{"column":"city","op":"missing"}]}]},"sql":"SELECT * FROM orders WHERE customer IS NULL OR city IS NULL ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","customer","city","amount","placed","parent"],"rows":[["4","4",null,"Pune","75","2026-02-20","2"],["6","6","c1",null,"10","2026-03-15",null]]},"sql":{"columns":["__row","order_id","customer","city","amount","placed","parent"],"rows":[["4","4",null,"Pune","75","2026-02-20","2"],["6","6","c1",null,"10","2026-03-15",null]]}}},
 {"id":"sort","operation":"Sorting: missing values last","pipeline":{"source":"orders","steps":[{"op":"sort","keys":[{"column":"city","desc":true}]},{"op":"columns","keep":["order_id","city"]}]},"sql":"SELECT __row, order_id, city FROM orders ORDER BY city DESC NULLS LAST, __row","expect":{"controls":{"columns":["__row","order_id","city"],"rows":[["4","4","Pune"],["1","1","Oslo"],["5","5","Oslo"],["2","2","Lima"],["3","3","Lima"],["6","6",null]]},"sql":{"columns":["__row","order_id","city"],"rows":[["4","4","Pune"],["1","1","Oslo"],["5","5","Oslo"],["2","2","Lima"],["3","3","Lima"],["6","6",null]]}}},
 {"id":"limit","operation":"Limits: the first rows in an explicit order","pipeline":{"source":"orders","steps":[{"op":"sort","keys":[{"column":"placed","desc":true}]},{"op":"limit","n":2},{"op":"columns","keep":["order_id","placed"]}]},"sql":"SELECT __row, order_id, placed FROM orders ORDER BY placed DESC NULLS LAST, __row LIMIT 2","expect":{"controls":{"columns":["__row","order_id","placed"],"rows":[["6","6","2026-03-15"],["5","5","2026-03-01"]]},"sql":{"columns":["__row","order_id","placed"],"rows":[["6","6","2026-03-15"],["5","5","2026-03-01"]]}}},
 {"id":"distinct","operation":"Distinct values: a missing value is one value","pipeline":{"source":"orders","steps":[{"op":"distinct","columns":["customer"]}]},"sql":"SELECT DISTINCT customer FROM orders ORDER BY customer NULLS LAST","expect":{"controls":{"columns":["customer"],"rows":[["c1"],["c2"],["c9"],[null]]},"sql":{"columns":["customer"],"rows":[["c1"],["c2"],["c9"],[null]]}}},
 {"id":"expression","operation":"Expressions: arithmetic propagates missing values","pipeline":{"source":"orders","steps":[{"op":"compute","name":"doubled","kind":"arith","a":{"column":"amount"},"operator":"*","b":{"value":2}},{"op":"columns","keep":["order_id","doubled"]}]},"sql":"SELECT __row, order_id, TRY_CAST(amount AS DOUBLE) * 2 AS doubled FROM orders ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","doubled"],"rows":[["1","1",null],["2","2","80.0"],["3","3",null],["4","4","150.0"],["5","5",null],["6","6","20.0"]]},"sql":{"columns":["__row","order_id","doubled"],"rows":[["1","1",null],["2","2","80.0"],["3","3",null],["4","4","150.0"],["5","5",null],["6","6","20.0"]]}}},
 {"id":"case","operation":"CASE: a missing value takes the ELSE branch","pipeline":{"source":"orders","steps":[{"op":"compute","name":"big","kind":"case","column":"amount","test":">=","value":"50","then":"big","else":"small"},{"op":"columns","keep":["order_id","big"]}]},"sql":"SELECT __row, order_id, CASE WHEN TRY_CAST(amount AS DOUBLE) >= 50 THEN 'big' ELSE 'small' END AS big FROM orders ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","big"],"rows":[["1","1","small"],["2","2","small"],["3","3","small"],["4","4","big"],["5","5","small"],["6","6","small"]]},"sql":{"columns":["__row","order_id","big"],"rows":[["1","1","small"],["2","2","small"],["3","3","small"],["4","4","big"],["5","5","small"],["6","6","small"]]}}},
 {"id":"cast","operation":"Casts: TRY_CAST makes a value that does not convert missing, and counts it","pipeline":{"source":"orders","steps":[{"op":"compute","name":"amount","kind":"convert","column":"amount","type":"BIGINT"},{"op":"columns","keep":["order_id","amount"]}]},"sql":"SELECT __row, order_id, TRY_CAST(amount AS BIGINT) AS amount FROM orders ORDER BY __row","expect":{"controls":{"columns":["__row","order_id","amount"],"rows":[["1","1",null],["2","2","40"],["3","3",null],["4","4","75"],["5","5",null],["6","6","10"]]},"sql":{"columns":["__row","order_id","amount"],"rows":[["1","1",null],["2","2","40"],["3","3",null],["4","4","75"],["5","5",null],["6","6","10"]]}}},
