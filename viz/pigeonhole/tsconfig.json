// Type-checked JavaScript: tsc checks the JSDoc types in this repository's own JavaScript and emits nothing.
// `npm run typecheck` first runs scripts/extract-inline.mjs, which copies the page's own inline scripts out of
// index.html into .typecheck/inline/ as global scripts; types/page.d.ts declares what the page's globals hold.
// Left out: beamdswitch.js and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and
// beamdswitch's parser (and so the inline beamdswitch copy too).
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["tests/*.mjs", "scripts/*.mjs", ".typecheck/inline/*.js", "types/*.d.ts"]
}
