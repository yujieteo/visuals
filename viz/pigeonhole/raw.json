  "challenges": [
    {
      "id": "A",
      "prompt": "101 objects are placed into 10 boxes. What must be true?",
      "options": [
        "Some box has ≥ 10",
        "Some box has ≥ 11",
        "Some box has ≥ 12",
        "Every box has ≥ 11"
      ],
      "answer": 1,
      "notes": {
        "0": "That is true as well, since a box with 11 has at least 10, but it is weaker than what the total forces."
      },
      "explain": "101/10 = 10.1, so ⌈101/10⌉ = 11: if every box held at most 10, the boxes would hold at most 10 · 10 = 100 < 101. Twelve is not forced (11, 10, …, 10 is possible), and “every box” is not forced either: 101 + 0 + ⋯ + 0 is possible."
    },
    {
      "id": "B",
      "prompt": "The average of eight numbers is 17. Could all eight numbers be below 17?",
      "options": [
        "Yes",
        "No"
      ],
      "answer": 1,
      "explain": "No. If every number were below 17, their sum would be below 8 · 17 = 136. But an average of 17 means the sum is exactly 136."
    },
    {
      "id": "C",
      "prompt": "The average is 12. One value is 19. Must some value be below 12?",
      "options": [
        "Yes",
        "No"
      ],
      "answer": 0,
      "explain": "Yes. The value 19 has deviation +7 from the average. Deviations from the average always sum to 0, so some deviation must be negative: some value lies strictly below 12."
    },
    {
      "id": "D",
      "prompt": "Can the average equal the maximum?",
      "options": [
        "Never",
        "Yes, but only if every value equals the maximum",
        "Yes, whenever one value is the maximum"
      ],
      "answer": 1,
      "explain": "Yes, but only when all values are equal. If some value were below the maximum and none above it, the sum would be below n · max, so the average would be below the maximum."
    }
  ],
