// This visual's type-checked JavaScript (the files included below), one tsc project of its own, which
// scripts/typecheck.mjs runs per visual from scripts/check.py after npm ci at the repository root.
// Compiler options come from ../../tsconfig.base.json.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy"
  },
  "include": [
    "report.js",
    "tests/*.mjs",
    "types/*.d.ts"
  ]
}
