// Type-checked JavaScript: tsc checks the JSDoc types in this repository's own JavaScript and emits nothing:
// report.js (which index.html inlines verbatim) and the tests. types/ declares what the left-out copies provide.
// Left out: index.html's page script, which yujieteo/visuals generates and types at its source; beamdswitch.js
// and tests/fixtures/beamdswitch/, read-only copies of yujieteo/site's template and beamdswitch's parser
// (deck.d.mts types the parser).
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["report.js", "tests/*.mjs", "types/*.d.ts"]
}
