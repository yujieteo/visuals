// Compiler options shared by every type-checked project: the shared tooling's tsconfig.json and each visual's
// viz/<slug>/tsconfig.json, which extends this file and lists only its own files. tsc checks JSDoc types in
// plain JavaScript and emits nothing.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true
  }
}
