{
  "name": "visuals-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser end-to-end checks for the visuals, run against each artifact as standalone software: the shared harness here, each visual's manifest and fuller checks in its viz/<slug>/e2e/.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "page-axi": "bin/page-axi.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test:harness": "node --test tests/harness.test.js tests/page-axi.test.js",
    "test:page-axi": "node --test tests/page-axi.browser.test.js",
    "page-axi": "node bin/page-axi.js",
    "test:baseline": "node --test tests/baseline.test.js",
    "test:standalone": "node --test tests/standalone.test.js",
    "test:full": "node --test ../viz/*/e2e/full.test.mjs",
    "findings": "node scripts/findings.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
