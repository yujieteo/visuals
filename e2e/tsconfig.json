{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    // Each visual's e2e/full.test.mjs sits outside this folder; its JSDoc types name playwright, installed here.
    "paths": { "playwright": ["./node_modules/playwright/index.d.ts"] }
  },
  "include": ["bin/**/*.js", "lib/**/*.js", "tests/**/*.js", "scripts/**/*.js", "../viz/*/e2e/*.mjs"]
}
